{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "preview"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_DEMO_AUTH_ENABLED": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "ios-preview": {
      "distribution": "internal",
      "environment": "preview"
    }
  }
}