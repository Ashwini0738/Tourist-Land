# PostgreSQL connection used by Drizzle ORM when persistence is enabled.
DATABASE_URL=postgresql://user:password@host:5432/travel_land

# Server-side session encryption. Store the real value in Replit Secrets.
SESSION_SECRET=replace-with-a-long-random-value

# Razorpay credentials are server-only. Use matching test-mode values during
# development, and store real values in Replit Secrets rather than this file.
# Only RAZORPAY_KEY_ID is returned to the native checkout SDK.
RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-separate-razorpay-webhook-secret

# Public host injected into Expo builds by Replit.
EXPO_PUBLIC_DOMAIN=your-development-or-production-domain

# Comma-separated browser origins allowed to make credentialed API requests.
# Leave unset to allow only same-origin/no-origin requests plus detected Replit
# development domains; never use "*" with credentials.
TRAVEL_LAND_CORS_ORIGINS=https://your-admin-domain.example,https://your-app-domain.example

# Future Supabase Auth foundation. These example values are intentionally inert.
# Never expose a Supabase secret/service-role key through EXPO_PUBLIC_* or VITE_*.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
SUPABASE_JWT_AUDIENCE=authenticated
# Fail-closed API provider selector. clerk is the default; dual is a temporary
# bridge, and supabase is reserved for the final cutover.
TRAVEL_LAND_API_AUTH_PROVIDER=clerk

# Optional server-side live data providers. Leave unset to keep Explore in discovery-preview mode.
# Each provider should return JSON with an `items` array keyed by the catalog item `id`.
HOTEL_AVAILABILITY_PROVIDER_URL=
HOTEL_AVAILABILITY_PROVIDER_API_KEY=
EVENT_SCHEDULE_PROVIDER_URL=
EVENT_SCHEDULE_PROVIDER_API_KEY=